# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# Every variable has a default in src/settings.py, so an empty .env works for
# public data. Values can also be given on the command line: --END_DATE=2020-12-31

# Where pulled data and generated outputs go. Relative paths are resolved from
# the project root. Point these at a shared drive or HPC scratch if needed.
# Note: reports/report.tex and chartbook.toml read the default _output/ and
# _data/ paths; update them too if you move these folders.
# DATA_DIR=_data
# OUTPUT_DIR=_output

# Sample window used by the cleaning step. Changing it reruns clean_data and
# everything downstream (doit tracks it with config_changed).
# START_DATE=1990-01-01
# END_DATE=2024-12-31

# Credentials for licensed sources (only needed when you add such a pull).
# WRDS_USERNAME=
